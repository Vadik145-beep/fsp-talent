# Стенд fsp-talent: один адрес — фронт, API, вход через ФСП ID (Keycloak).
{$STAND_HOST} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	# Keycloak работает с относительным путём /kc (KC_HTTP_RELATIVE_PATH)
	handle /kc/* {
		reverse_proxy keycloak:8080
	}
	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
