# Стенд: скопируйте в infra/stand/.env и задайте свои значения (файл .env в git не попадает)
STAND_HOST=159-194-200-243.sslip.io
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-32-plus-chars
ADMIN_PASSWORD=demo1234
KEYCLOAK_ADMIN_PASSWORD=change-me
FSP_WEBHOOK_SECRET=change-me
# Почта: настоящий SMTP-ящик (письма подтверждения, сброса пароля, приглашений).
# Яндекс: включить IMAP с «портальным паролем» в настройках почты и создать пароль
# приложения на id.yandex.ru/security/app-passwords (тип «Почта»).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=fsp.talent@yandex.ru
SMTP_PASSWORD=change-me
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Локальная LLM (Qwen2.5-1.5B, ~1 ГБ RAM): раскомментировать, чтобы поднять сервис llm
