# Скопируйте в .env и при необходимости поменяйте. Без .env всё работает на значениях по умолчанию.

# --- Общее ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp_talent
# Строка подключения бэкенда (внутри compose хост — postgres, с хоста — localhost:15432)
DATABASE_URL=postgresql+asyncpg://fsp:fsp@postgres:5432/fsp_talent

# --- Авторизация (волна 2) ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# До волны 2 роль берётся из заголовка X-Demo-Role. На проде выключить.
DEMO_AUTH_ENABLED=true

# Администратор по умолчанию: создаётся при старте бэкенда, если такой почты ещё нет.
# Dev-compose эти две переменные в контейнер НЕ передаёт — локально вход admin@example.com / demo1234
# (значение по умолчанию в app/core/config.py). Отсюда они действуют, только если запускать uvicorn
# вручную из backend/ с копией этого файла как backend/.env.
# На стенде пароль задаётся в infra/stand/.env (ADMIN_PASSWORD, см. infra/stand/.env.example);
# вне dev пароль demo1234 / change-me даёт предупреждение в логе.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Почта (в dev — Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fsp-talent.example.com
# Адрес фронтенда для ссылок в письмах
PUBLIC_FRONTEND_URL=http://localhost:15173

# --- Keycloak (вход и привязка через ФСП ID) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Адрес, который видит браузер
KEYCLOAK_PUBLIC_URL=http://localhost:18180
# Адрес, который видит бэкенд внутри compose
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=fsp
KEYCLOAK_CLIENT_ID=fsp-talent

# --- Мок реестра ФСП ---
FSP_REGISTRY_URL=http://fsp-registry-mock:8000

# --- Необязательные настройки модулей (dev-compose их не передаёт, значения по умолчанию — в коде) ---
# Секрет HMAC вебхука реестра ФСП (X-FSP-Signature); по умолчанию dev-fsp-webhook-secret,
# пустая строка выключает вебхук (503 webhook_disabled). На стенде — в infra/stand/.env.
# FSP_WEBHOOK_SECRET=
# Регулярные задания: прибавки к свежести и период полураспада (app/tasks/settings.py)
# TASKS_FRESHNESS_ANSWER_BONUS=0.08
# TASKS_FRESHNESS_HALF_LIFE_DAYS=30
# Вебхуки ATS: на проде запретить адреса localhost и частных сетей (защита от SSRF)
# INTEGRATIONS_ALLOW_PRIVATE_URLS=true

# --- LLM (необязательно: без неё всё работает на правилах) ---
# Любой OpenAI-совместимый endpoint (/chat/completions). Своя открытая модель на этом же
# сервере: docker compose --profile llm up -d llm и значения ниже (на стенде заданы по умолчанию):
#   LLM_BASE_URL=http://llm:8080/v1  LLM_API_KEY=local  LLM_MODEL=qwen2.5-1.5b-instruct
#   LLM_JSON_SCHEMA=true  LLM_DISPLAY_NAME=Qwen2.5-1.5B  LLM_LOCAL=true
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# true — передавать JSON-схему ответа (llama.cpp строит по ней грамматику)
LLM_JSON_SCHEMA=false
# подпись модели в интерфейсе и признак «работает на нашем сервере»
LLM_DISPLAY_NAME=
LLM_LOCAL=false
# true — не вызывать модель вовсе (выключатель на стенде)
LLM_DISABLED=false
# Таймауты (с): черновик задачи, разбор потребности, дозаполнение резюме
# LLM_DRAFT_TIMEOUT_SEC=90
# LLM_NEED_TIMEOUT_SEC=25
# LLM_RESUME_TIMEOUT_SEC=40
# LLM_MAX_DRAFTS=2

# --- Фронтенд ---
# vite dev проксирует /api на бэкенд; в compose цель задана как http://backend:8000
VITE_PROXY_TARGET=http://localhost:18000
VITE_USE_MOCKS=true
