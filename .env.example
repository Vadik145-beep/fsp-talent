# Скопируйте в .env и при необходимости поменяйте. Без .env всё работает на значениях по умолчанию.

# --- Общее ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp_talent
# Строка подключения бэкенда (внутри compose хост — postgres, с хоста — localhost:15432)
DATABASE_URL=postgresql+asyncpg://fsp:fsp@postgres:5432/fsp_talent

# --- Авторизация (волна 2) ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# До волны 2 роль берётся из заголовка X-Demo-Role. На проде выключить.
DEMO_AUTH_ENABLED=true

# Администратор по умолчанию (создаётся сидом, волна 2)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Почта (в dev — Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fsp-talent.example.com
# Адрес фронтенда для ссылок в письмах
PUBLIC_FRONTEND_URL=http://localhost:15173

# --- Keycloak (вход и привязка через ФСП ID) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Адрес, который видит браузер
KEYCLOAK_PUBLIC_URL=http://localhost:18180
# Адрес, который видит бэкенд внутри compose
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=fsp
KEYCLOAK_CLIENT_ID=fsp-talent

# --- Мок реестра ФСП ---
FSP_REGISTRY_URL=http://fsp-registry-mock:8000

# --- LLM (необязательно: без ключа всё работает на правилах) ---
# openai — любой OpenAI-совместимый endpoint, anthropic — Anthropic API
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Фронтенд ---
VITE_API_URL=http://localhost:18000/api
VITE_USE_MOCKS=true
